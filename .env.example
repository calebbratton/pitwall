# Copy to .env and fill in. Never export these in your shell profile.

# groq (default, free tier) | anthropic (explicit opt-in only, costs money)
LLM_PROVIDER=groq

# Optional for groq (per-role defaults in src/llm/factory.py); REQUIRED for anthropic.
LLM_MODEL=
# Per-role overrides, e.g. LLM_MODEL_ANALYST=openai/gpt-oss-120b
# LLM_MODEL_ROUTER=
# LLM_MODEL_FETCHER=
# LLM_MODEL_ANALYST=
# LLM_MODEL_JUDGE=

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Leave empty until you've set a spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=
